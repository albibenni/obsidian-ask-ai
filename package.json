{
  "name": "ask-ai",
  "version": "0.1.0",
  "description": "Open Obsidian note context in a new consumer AI chat",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "release": "node release.mjs",
    "version": "node version-bump.mjs && node verify-release.mjs && pnpm run format && git add manifest.json versions.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:metadata": "node verify-release.mjs",
    "check": "pnpm run lint && pnpm run test && pnpm run check:metadata && pnpm run build",
    "prepare": "husky"
  },
  "keywords": [
    "obsidian",
    "chatgpt",
    "claude",
    "gemini"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^26.1.2",
    "esbuild": "0.28.1",
    "husky": "^9.1.7",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24"
  }
}
